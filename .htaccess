DirectoryIndex index.html index.php
# Evitar que la caché del servidor muestre versiones viejas de las páginas
<IfModule LiteSpeed>
CacheLookup off
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
ErrorDocument 404 /404.html
RewriteEngine On
# Redirección a HTTPS desactivada temporalmente hasta que Hostinger active el certificado SSL
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.alessandrozavala.com%{REQUEST_URI} [L,R=301]
# Bloquear accesos a restos de WordPress
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin) - [F,L]
# Artículos técnicos movidos a Estudio E-commerce
Redirect 301 /blog/facebook-ads-para-principiantes/ https://estudioecommerce.com.mx/blog/facebook-ads-para-principiantes/
